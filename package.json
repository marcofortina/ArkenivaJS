{
  "name": "arkenivajs-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/check.mjs",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:contract": "node scripts/test.mjs contract",
    "test:property": "node scripts/test.mjs property",
    "test": "node scripts/test.mjs all",
    "coverage": "node scripts/test.mjs all --coverage",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test:unit && pnpm test:contract && pnpm coverage && pnpm test:docs && pnpm docs:build && pnpm smoke",
    "test:docs": "pnpm --filter './examples/*' test",
    "docs:build": "typedoc --options typedoc.json && node scripts/check-docs.mjs",
    "test:integration": "node scripts/test.mjs integration",
    "test:integration:telemetry": "node scripts/test.mjs telemetry-integration",
    "test:integration:metering": "node scripts/test.mjs metering-integration",
    "test:integration:postgres": "node scripts/test.mjs database-postgres-integration",
    "coverage:postgres": "pnpm --filter @arkenivajs/database-postgres coverage",
    "test:integration:mysql": "node scripts/test.mjs database-mysql-integration",
    "coverage:mysql": "pnpm --filter @arkenivajs/database-mysql coverage",
    "test:integration:mariadb": "node scripts/test.mjs database-mariadb-integration",
    "coverage:mariadb": "pnpm --filter @arkenivajs/database-mariadb coverage",
    "test:integration:oracle": "node scripts/test.mjs database-oracle-integration",
    "coverage:oracle": "pnpm --filter @arkenivajs/database-oracle coverage",
    "test:integration:redis": "node scripts/test.mjs database-redis-integration",
    "coverage:redis": "pnpm --filter @arkenivajs/database-redis coverage",
    "test:integration:etcd": "node scripts/test.mjs database-etcd-integration",
    "coverage:etcd": "pnpm --filter @arkenivajs/database-etcd coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "yaml": "2.9.1"
  }
}
