{
  "name": "arkenivajs-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/check.mjs",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:contract": "node scripts/test.mjs contract",
    "test:property": "node scripts/test.mjs property",
    "test": "node scripts/test.mjs all",
    "coverage": "node scripts/test.mjs all --coverage",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test:unit && pnpm test:contract && pnpm coverage && pnpm smoke"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.0",
    "prettier": "3.9.10",
    "fast-check": "4.10.2"
  }
}
