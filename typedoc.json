{
  "name": "ArkenivaJS",
  "entryPointStrategy": "packages",
  "entryPoints": ["packages/*"],
  "out": ".build/api",
  "readme": "README.md",
  "projectDocuments": ["docs/*.md", "examples/*/README.md"],
  "includeVersion": true,
  "hideGenerator": true,
  "treatWarningsAsErrors": true,
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "tsx",
    "typescript",
    "sql"
  ],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "tsconfig": "tsconfig.json",
    "validation": {
      "notExported": true,
      "invalidLink": true,
      "notDocumented": false
    }
  }
}
