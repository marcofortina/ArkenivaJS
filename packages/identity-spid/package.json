{
  "name": "@arkenivajs/identity-spid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./support": {
      "types": "./dist/support.d.ts",
      "import": "./dist/support.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node ../../scripts/test.mjs all",
    "test:unit": "node ../../scripts/test.mjs unit",
    "test:integration:postgres": "node --test dist-test/integration/transactions.integration.test.js",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@arkenivajs/core": "workspace:*",
    "@arkenivajs/http": "workspace:*",
    "@arkenivajs/security-apikey": "workspace:*",
    "@arkenivajs/security-crypto": "workspace:*",
    "@arkenivajs/security-saml": "workspace:*",
    "@xmldom/xmldom": "0.8.15",
    "jose": "6.2.13",
    "openid-client": "6.8.8",
    "validator": "13.15.35",
    "xml-crypto": "6.4.0"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@arkenivajs/logging": "workspace:*",
    "@arkenivajs/security": "workspace:*",
    "@arkenivajs/telemetry": "workspace:*",
    "@types/validator": "13.15.10"
  }
}
