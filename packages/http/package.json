{
  "name": "@arkenivajs/http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "format:check": "prettier --check src test",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node ../../scripts/test.mjs all",
    "test:unit": "node --test dist-test/test/unit/*.test.js",
    "test:contract": "node --test dist-test/test/contract/*.test.js"
  },
  "dependencies": {
    "@arkenivajs/core": "workspace:*",
    "undici": "8.12.3"
  }
}
