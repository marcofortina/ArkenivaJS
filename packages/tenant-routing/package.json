{
  "name": "@arkenivajs/tenant-routing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "bin": {
    "arkenivajs-tenant-registry": "./dist/registry-bin.js"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "exports": {
    "./event-schema": {
      "types": "./dist/event-schema.d.ts",
      "import": "./dist/event-schema.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "compat",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node ../../scripts/test.mjs all",
    "test:unit": "node ../../scripts/test.mjs unit",
    "test:contract": "node ../../scripts/test.mjs contract",
    "test:integration:http": "node --test dist-test/integration/routing.integration.test.js dist-test/integration/assurance-freshness.integration.test.js dist-test/integration/tenant-membership-freshness.integration.test.js dist-test/integration/capabilities-lifecycle.integration.test.js dist-test/integration/capabilities-scale.integration.test.js dist-test/integration/concurrency-isolation.integration.test.js dist-test/integration/upstream.integration.test.js dist-test/integration/transformation-lifecycle.integration.test.js dist-test/integration/observation.integration.test.js dist-test/integration/usage.integration.test.js dist-test/integration/header-ambiguity.integration.test.js",
    "test:integration:postgres": "node --test dist-test/integration/postgres.integration.test.js",
    "test:integration:file": "node --test dist-test/integration/file.integration.test.js",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@arkenivajs/core": "workspace:*",
    "@arkenivajs/api": "workspace:*",
    "@arkenivajs/database": "workspace:*",
    "@arkenivajs/proxy": "workspace:*",
    "fastify": "5.12.7",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@arkenivajs/metering": "workspace:*",
    "@arkenivajs/telemetry": "workspace:*",
    "@arkenivajs/logging": "workspace:*",
    "@arkenivajs/security": "workspace:*",
    "jose": "6.2.13",
    "@arkenivajs/database-postgres": "workspace:*"
  },
  "license": "AGPL-3.0-or-later"
}
