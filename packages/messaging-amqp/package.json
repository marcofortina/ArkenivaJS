{
  "name": "@arkenivajs/messaging-amqp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "compat",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node ../../scripts/test.mjs all",
    "test:unit": "node ../../scripts/test.mjs unit",
    "lint": "eslint src test",
    "test:integration": "node ../../scripts/test.mjs integration"
  },
  "dependencies": {
    "@arkenivajs/core": "workspace:*",
    "amqplib": "2.2.0"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@arkenivajs/logging": "workspace:*",
    "@arkenivajs/telemetry": "workspace:*"
  }
}
