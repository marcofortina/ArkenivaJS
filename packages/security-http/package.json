{
  "name": "@arkenivajs/security-http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node ../../scripts/test.mjs all",
    "test:unit": "node ../../scripts/test.mjs unit",
    "lint": "eslint src test",
    "test:integration": "node ../../scripts/test.mjs all"
  },
  "dependencies": {
    "@arkenivajs/core": "workspace:*",
    "@arkenivajs/api": "workspace:*",
    "@arkenivajs/security-sessions": "workspace:*",
    "@fastify/helmet": "13.2.0",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/csrf": "8.1.1",
    "@fastify/cookie": "11.1.3",
    "fastify": "5.12.7",
    "helmet": "8.3.0"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@arkenivajs/logging": "workspace:*",
    "@arkenivajs/telemetry": "workspace:*"
  }
}
