{
  "name": "@arkenivajs/mail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node ../../scripts/test.mjs all",
    "test:unit": "node ../../scripts/test.mjs unit",
    "lint": "eslint src test",
    "test:integration": "node --test dist-test/unit/smtp.unit.test.js"
  },
  "dependencies": {
    "@arkenivajs/core": "workspace:*",
    "nodemailer": "10.2.1",
    "mustache": "4.2.0",
    "sanitize-html": "2.18.1",
    "validator": "13.15.35"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/mustache": "4.2.6",
    "@types/sanitize-html": "2.16.2",
    "@types/validator": "13.15.10",
    "smtp-server": "3.21.1",
    "mailparser": "3.12.4"
  }
}
