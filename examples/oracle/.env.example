# Variable inventory only; this application does not load dotenv files automatically.
# Real Oracle compatibility is optional and remains unverified without the live suite.
ARKENIVA_ORACLE_LIVE=0
# Set the sentinel to 1 only after provisioning an authorized disposable Oracle server.
# ARKENIVA_ORACLE_URL is supplied privately; never store actual credentials in this file.
