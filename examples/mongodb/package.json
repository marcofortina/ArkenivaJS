{
  "name": "@arkenivajs/example-mongodb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test dist-test/unit/*.test.js",
    "test:integration": "node --test dist-test/integration/*.test.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@arkenivajs/core": "workspace:*",
    "@arkenivajs/database-mongodb": "workspace:*",
    "mongodb": "7.7.0",
    "mongodb-connection-string-url": "7.0.2"
  }
}
